# ─── Espace admin ────────────────────────────────────────────────
# Email autorisé à se connecter à /admin
ADMIN_EMAIL=admin@gourmandisesbynani.com

# Hash bcrypt du mot de passe admin.
# Génère-le avec : node scripts/hash-password.mjs "TonMotDePasse"
# ⚠️ Garde bien les \$ dans le résultat collé ci-dessous, sinon Next.js
# interprète le $ comme une variable et casse le mot de passe.
ADMIN_PASSWORD_HASH=\$2b\$12\$DpkaArGv7ndfF9pUyIg7uuAuH17lsHkTrhraaOKQ/La1K17LH1Zy6

# Clé secrète pour signer les sessions (génère une longue chaîne aléatoire)
# Exemple pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire-secrete

# ─── Supabase — OBLIGATOIRE pour un hébergement serverless (Vercel...) ──
# Sans ces variables, les commandes/créations/galerie sont stockées dans
# des fichiers locaux qui NE PERSISTENT PAS sur Vercel.
# Récupère ces valeurs dans Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cloudinary — recommandé pour un hébergement serverless (Vercel...) ──
# Sans ces variables, les images uploadées depuis l'admin sont stockées
# localement et NE PERSISTENT PAS sur Vercel.
# Récupère ces valeurs sur https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=xxxxxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxx
